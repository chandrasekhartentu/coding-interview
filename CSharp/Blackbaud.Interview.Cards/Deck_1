namespace Blackbaud.Interview.Cards;

/// <summary>
/// A deck of cards
/// </summary>
public class Deck
{
    private readonly Stack<Card> _stackOfCards;
    private readonly object _syncRoot = new object();

    /// <summary>
    /// Private constructor for a new deck of <paramref name="cards"/>.
    /// Use Deck.NewDeck() static factory method.
    /// </summary>
    /// <param name="cards"></param>
    private Deck(IEnumerable<Card> cards)
    {
        _stackOfCards = new Stack<Card>(cards);
    }

    /// <summary>
    /// Creates and returns a new deck of cards.
    /// </summary>
    /// <returns></returns>
    public static Deck NewDeck()
    {
        return new Deck(BuildDefaultDeck());
    }

    private static IEnumerable<Card> BuildDefaultDeck()
    {
        return Enum.GetValues<Suit>().SelectMany(suit =>
            Enum.GetValues<Rank>().Select(rank =>
                new Card(rank, suit)));
    }

    /// <summary>
    /// Resets the deck back to a full, ordered deck.
    /// </summary>
    public void Reset()
    {
        lock (_syncRoot)
        {
            _stackOfCards.Clear();
            foreach (var card in BuildDefaultDeck())
            {
                _stackOfCards.Push(card);
            }
        }
    }

    /// <summary>
    /// Resets the deck and shuffles it.
    /// </summary>
    public void ResetAndShuffle()
    {
        Reset();
        Shuffle();
    }

    /// <summary>
    /// The number of remaining cards in the deck
    /// </summary>
    public int RemainingCards
    {
        get
        {
            lock (_syncRoot)
            {
                return _stackOfCards.Count;
            }
        }
    }

    /// <summary>
    /// Returns true if there are no remaining cards in the deck
    /// </summary>
    public bool Empty
    {
        get
        {
            lock (_syncRoot)
            {
                return _stackOfCards.Count == 0;
            }
        }
    }

    /// <summary>
    /// Removes the next card from the deck.
    /// </summary>
    /// <returns>The next card from the deck.
    /// Returns null if no cards remain.</returns>
    public Card NextCard()
    {
        lock (_syncRoot)
        {
            if (_stackOfCards.Count > 0)
            {
                return _stackOfCards.Pop();
            }

            return null;
        }
    }

    /// <summary>
    /// Returns the next card without removing it from the deck.
    /// </summary>
    /// <returns>The next card, or null if the deck is empty.</returns>
    public Card Peek()
    {
        lock (_syncRoot)
        {
            return _stackOfCards.Count > 0 ? _stackOfCards.Peek() : null;
        }
    }

    /// <summary>
    /// Returns the next <paramref name="count"/> cards without removing them from the deck.
    /// </summary>
    /// <param name="count">The number of cards to peek.</param>
    /// <returns>A read-only list containing the next cards in deck order.</returns>
    /// <exception cref="ArgumentOutOfRangeException">Thrown when count is negative.</exception>
    /// <exception cref="InvalidOperationException">Thrown when there are not enough cards left.</exception>
    public IReadOnlyList<Card> Peek(int count)
    {
        if (count < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(count), "Count must be non-negative.");
        }

        lock (_syncRoot)
        {
            if (count > _stackOfCards.Count)
            {
                throw new InvalidOperationException($"Not enough cards remain to peek {count} cards.");
            }

            var cards = _stackOfCards.ToArray();
            var peeked = new List<Card>(count);
            for (int i = 0; i < count; i++)
            {
                peeked.Add(cards[i]);
            }

            return peeked.AsReadOnly();
        }
    }

    /// <summary>
    /// Deals a specific number of cards from the deck.
    /// </summary>
    /// <param name="count">The number of cards to deal.</param>
    /// <returns>A readonly list containing the dealt cards.</returns>
    /// <exception cref="ArgumentOutOfRangeException">Thrown when count is negative.</exception>
    /// <exception cref="InvalidOperationException">Thrown when there are not enough cards left.</exception>
    public IReadOnlyList<Card> DealHand(int count)
    {
        if (count < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(count), "Count must be non-negative.");
        }

        lock (_syncRoot)
        {
            if (count > _stackOfCards.Count)
            {
                throw new InvalidOperationException($"Not enough cards remain to deal {count} cards.");
            }

            var hand = new List<Card>(count);
            for (int i = 0; i < count; i++)
            {
                hand.Add(_stackOfCards.Pop());
            }

            return hand.AsReadOnly();
        }
    }

    /// <summary>
    /// Shuffles the deck randomly.
    /// </summary>
    public void Shuffle()
    {
        lock (_syncRoot)
        {
            var cards = _stackOfCards.ToArray();
            var random = new Random();
            for (int i = cards.Length - 1; i > 0; i--)
            {
                int j = random.Next(i + 1);
                (cards[i], cards[j]) = (cards[j], cards[i]);
            }
            _stackOfCards.Clear();
            foreach (var card in cards)
            {
                _stackOfCards.Push(card);
            }
        }
    }

}


